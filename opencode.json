{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "supabase": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@supabase/mcp-server-supabase@latest",
        "--access-token",
        "{env:SUPABASE_ACCESS_TOKEN}"
      ],
      "enabled": true
    }
  }
}
